# ==============================================================================
# Environment Configuration Example — Trail-to-Road Effort Converter
# ==============================================================================
# NOTE: MVP is a 100% client-side static calculator and requires ZERO secrets
# to function. Never place private API keys or secrets in VITE_* variables,
# as Vite bundles VITE_* variables directly into client-side JavaScript.
# ==============================================================================

# Local / Docker Compose host port binding (used by docker-compose.yml)
APP_PORT=8080

# Optional public metadata overrides (for future analytics/telemetry opt-in)
VITE_APP_NAME="Trail-to-Road Effort Converter"
VITE_APP_VERSION="1.0.0"
